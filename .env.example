# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HINDSIGHT_API_URL: URL of your Hindsight instance by Vectorize.
# Defaults to http://localhost:8888 for local Docker self-hosted Hindsight,
# or https://api.hindsight.vectorize.io for Hindsight Cloud.
HINDSIGHT_API_URL="http://localhost:8888"

# HINDSIGHT_API_KEY: API key for Hindsight Cloud or authenticated self-hosted instances.
# Leave blank or omit when using an unauthenticated local Hindsight Docker instance.
HINDSIGHT_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PORT=3000
